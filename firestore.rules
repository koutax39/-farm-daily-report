rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /farmDailyReportMasters/{document=**} {
      allow read, write: if true;
    }

    match /farmDailyReportDailyInfo/{document=**} {
      allow read, write: if true;
    }

    match /farmDailyReportWorks/{document=**} {
      allow read, write: if true;
    }
  }
}
